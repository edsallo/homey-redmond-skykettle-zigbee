{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./.homeybuild",
    "allowSyntheticDefaultImports": true
  },
  "include": ["app.ts", "drivers/**/*.ts", "lib/**/*.ts"],
  "exclude": ["node_modules"]
}
